{
  "buildCommand": "npm run release",
  "outputDirectory": "build/web",
  "rewrites": [
    {"source": "/sitemap.xml", "destination": "/api/sitemap"},
    {"source": "/design", "destination": "/design.html"},
    {"source": "/movie/:path*", "destination": "/index.html"},
    {"source": "/tv/:path*", "destination": "/index.html"}
  ],
  "headers": [
    {"source": "/msx/(.*)", "headers": [{"key": "Access-Control-Allow-Origin", "value": "*"}]}
  ]
}
