# Copy to .env.local and fill in. Never commit real values.

# Supabase project (public)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server only: service_role key, bypasses RLS. Used by api/admin/agents.js and scripts/agent-admin/push.js
SUPABASE_SERVICE_KEY=lorem

# Server only: credentials for the HOOK TV admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=lorem
