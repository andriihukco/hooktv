#!/usr/bin/env bash
# Runs the file-size check on every branch being pushed.
# Git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
ZERO_SHA='^0+$'
dir="$(git rev-parse --show-toplevel)/.githooks"
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" =~ $ZERO_SHA ]] && continue # branch deletion
  "$dir/check-file-size.sh" "$remote_sha" "$local_sha" || status=1
done

exit $status
